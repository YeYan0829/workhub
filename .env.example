# Copy using scripts/init-env.py; generated local passwords are never committed.
COMPOSE_PROFILES=async
# Required for registration/verification emails and other background work.
WORKHUB_MESSAGING_ENABLED=true
# Local loopback HTTP only. Use secure cookies when serving over HTTPS.
SESSION_COOKIE_SECURE=false
MYSQL_DATABASE=workhub
MYSQL_USER=workhub
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=13306
RABBITMQ_USER=workhub
RABBITMQ_PASSWORD=
RABBITMQ_PORT=15672
ELASTICSEARCH_PORT=19200
REDIS_PORT=16379
APP_PORT=18080
# Optional external contracts; never paste keys into chat.
GITHUB_TOKEN=
GITHUB_TEST_REPOSITORY=
GITHUB_TEST_ISSUE_NUMBER=
GITHUB_TEST_PR_NUMBER=
GITHUB_TEST_RUN_ID=
GITHUB_DUPLICATE_ISSUE_NUMBER=
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_CHAT_ID=
MODEL_EMBEDDING_ID=
MODEL_EMBEDDING_DIMENSION=
# Keep false until the user approves a minimal paid smoke.
ALLOW_PAID_MODEL_SMOKE=false
ALLOW_GITHUB_WRITE_SMOKE=false

# Phase 3.x local SMTP receiver; production SMTP is configured separately.
SMTP_HOST=127.0.0.1
SMTP_PORT=11025
MAILPIT_PORT=18025
SMTP_AUTH=false
SMTP_STARTTLS=false
WORKHUB_PUBLIC_URL=http://127.0.0.1:18080
WORKHUB_MAIL_FROM=workhub@localhost
# Back up this generated 32-byte encryption key alongside the DB; never commit it.
WORKHUB_MAIL_KEY_FILE=.tools/mail.key

# Phase 4B native embedding API: complete URL matching account workspace/region.
MODEL_EMBEDDING_ENDPOINT=
WORKHUB_EMBEDDING_ENABLED=false
WORKHUB_RETRIEVAL_ENABLED=false
WORKHUB_EMBEDDING_MODEL=text-embedding-v4
WORKHUB_EMBEDDING_DIMENSIONS=1024
WORKHUB_EMBEDDING_CONFIG_ID=2
WORKHUB_EMBEDDING_INDEX=workhub-vector-v2
WORKHUB_EMBEDDING_PROTOCOL=dashscope
WORKHUB_EMBEDDING_PAID_APPROVED=false
WORKHUB_EMBEDDING_RUN_ID=
WORKHUB_EMBEDDING_BUDGET_USD=1
# Phase 5A: separate GLM authorization; disabled until configured. Never paste keys in chat.
WORKHUB_AGENT_ENABLED=false
WORKHUB_GLM_MODEL=glm-4.7
WORKHUB_GLM_ENDPOINT=https://api.z.ai/api/paas/v4/chat/completions
WORKHUB_GLM_API_KEY=
WORKHUB_GLM_PAID_APPROVED=false
WORKHUB_GLM_AUTHORIZATION_ID=
WORKHUB_GLM_BUDGET_USD=0

# Phase 5A comparison: separate CNY approvals/ledgers; runner reads these keys.
# Keep actual values in ignored .env; default application remains GLM and disabled.
DASHSCOPE_API_KEY=
ARK_API_KEY=

# Shared physical model-call admission; enable only after quota scope/limits and recovery initialization.
WORKHUB_MODEL_ADMISSION_ENABLED=false
WORKHUB_MODEL_QUOTA_SCOPE=
WORKHUB_MODEL_RATE=2
WORKHUB_MODEL_BURST=1
MODEL_ADMISSION_REDIS_HOST=127.0.0.1
MODEL_ADMISSION_REDIS_PORT=16380
MODEL_ADMISSION_REDIS_PASSWORD=
